# ===== 禁止泄露敏感凭证 =====
env/config.ini

# ===== 但不屏蔽示例配置模板 =====
!env/config.ini.example

# Python 字节码
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/

# 虚拟环境（整个 env/ 除例外）
env/*
!env/config.ini.example
!env/README.md

# .env 文件
.env/

